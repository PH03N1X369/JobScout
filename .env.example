# Copy this file to .env and fill in any keys you have. All are optional:
# without them JobScout still searches Himalayas, Jobicy, Remote OK, Remotive and Arbeitnow.

# JSearch (RapidAPI) - aggregates Google for Jobs: LinkedIn, Indeed, Glassdoor, company sites.
# Free tier: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=
JSEARCH_COUNTRY=us

# Adzuna - large job aggregator with a free developer tier: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Two-letter country code: us, gb, in, ca, au, de, fr, nl, ...
ADZUNA_COUNTRY=us

# PORT=5000
